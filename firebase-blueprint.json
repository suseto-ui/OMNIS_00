{
  "entities": {
    "User": {
      "title": "User",
      "description": "Uživatelský profil a RBAC oprávnění (STANDARD_USER vs. ADMIN_OPERATOR)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase UID vlastníka" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["STANDARD_USER", "ADMIN_OPERATOR"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp nebo ISO-8601" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Konverzační vlákno uživatele",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "Firebase UID vlastníka" },
        "title": { "type": "string" },
        "domain": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "title", "createdAt"]
    },
    "Record": {
      "title": "Record",
      "description": "Kognitivní AKGE-8D dotaz a syntéza odpovědi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "Firebase UID vlastníka" },
        "query": { "type": "string" },
        "response": { "type": "string" },
        "domain": { "type": "string" },
        "confidenceScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "query", "response", "createdAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Strategický cíl sledovaný v O.M.N.I.S.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "Firebase UID vlastníka" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "progress": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "status", "createdAt"]
    },
    "OverrideHistory": {
      "title": "OverrideHistory",
      "description": "Neměnný záznam Executive Override události pod uživatelem",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "integer", "description": "Epoch ms" },
        "prevState": { "type": "object" },
        "postState": { "type": "object" },
        "reason": { "type": "string" },
        "auditCommitmentSeal": { "type": "string" },
        "zkSnarkSeal": { "type": "string" },
        "prevCommitmentHash": { "type": "string" },
        "adminUser": { "type": "string" }
      },
      "required": ["id", "timestamp", "reason", "adminUser"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Neměnná kniha auditních otisků HMAC-SHA256 Hash Chain (append-only)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "actionType": { "type": "string" },
        "commitmentHash": { "type": "string" },
        "prevCommitmentHash": { "type": "string" },
        "commitmentAlgorithm": { "type": "string" },
        "timestamp": { "type": "integer" },
        "overrideActive": { "type": "boolean" },
        "triggerVector": { "type": "string" },
        "exclusionProof": { "type": "string" },
        "minimizationCheck": { "type": "string" },
        "details": { "type": "object" },
        "proofOfNecessity": { "type": "object" }
      },
      "required": ["userId", "actionType", "commitmentHash", "timestamp"]
    },
    "OmnisSession": {
      "title": "OmnisSession",
      "description": "Kontextová relace O.M.N.I.S. napříč zařízeními",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string" },
        "focusedDomain": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "status", "createdAt"]
    },
    "ProofOfNecessity": {
      "title": "ProofOfNecessity",
      "description": "Neměnný forenzní záznam Proof of Necessity (PoN)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "trigger_vector": { "type": "string" },
        "exclusion_proof": { "type": "string" },
        "minimization_check": { "type": "string" },
        "timestamp": { "type": "integer" },
        "system_tension_sigma": { "type": "number" }
      },
      "required": ["userId", "trigger_vector", "exclusion_proof", "minimization_check", "timestamp"]
    },
    "AgentDeliberation": {
      "title": "AgentDeliberation",
      "description": "Záznam deliberace multi-agentního jádra a Executive Override telemetrie",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "debateId": { "type": "string" },
        "timestamp": { "type": "integer" },
        "verdict": { "type": "string" },
        "overrideActive": { "type": "boolean" }
      },
      "required": ["userId", "debateId", "timestamp"]
    },
    "SystemMetrics": {
      "title": "SystemMetrics",
      "description": "Globální systémové metriky a stav synchronizace",
      "type": "object",
      "properties": {
        "tokens": { "type": "integer" },
        "syncStatus": { "type": "string" },
        "threats": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tokens", "syncStatus", "threats"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "Profil uživatele a role"
    },
    "/users/{userId}/threads/{threadId}": {
      "schema": { "$ref": "ChatThread" },
      "description": "Konverzační vlákna uživatele"
    },
    "/users/{userId}/records/{recordId}": {
      "schema": { "$ref": "Record" },
      "description": "Kognitivní záznamy uživatele"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "Goal" },
      "description": "Strategické cíle uživatele"
    },
    "/users/{userId}/override_history/{historyId}": {
      "schema": { "$ref": "OverrideHistory" },
      "description": "Neměnná historie Executive Override událostí"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Append-only kniha ZK-Audit otisků"
    },
    "/omnis_sessions/{sessionId}": {
      "schema": { "$ref": "OmnisSession" },
      "description": "Relace O.M.N.I.S."
    },
    "/proof_of_necessity/{ponId}": {
      "schema": { "$ref": "ProofOfNecessity" },
      "description": "Append-only forenzní PoN záznamy"
    },
    "/agent_deliberations/{deliberationId}": {
      "schema": { "$ref": "AgentDeliberation" },
      "description": "Multi-agentní deliberace a telemetrie"
    },
    "/system/{docId}": {
      "schema": { "$ref": "SystemMetrics" },
      "description": "Globální systémové metriky a konfigurace"
    }
  }
}
