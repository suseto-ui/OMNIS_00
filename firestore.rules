rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestampOrIso(val) {
      return (val is timestamp && val <= request.time) ||
        (val is string && val.size() >= 10 && val.size() <= 64);
    }

    function isVerifiedRootAdmin() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email == 'susetofu@gmail.com' &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        isVerifiedRootAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN_OPERATOR'
        )
      );
    }

    function isValidUserCreate(data, userId) {
      return data.keys().hasAll(['userId', 'email']) &&
        data.keys().hasOnly(['userId', 'email', 'displayName', 'username', 'role', 'createdAt', 'updatedAt']) &&
        data.userId == userId &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 320 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('username' in data) || (data.username is string && data.username.size() <= 120)) &&
        (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt)) &&
        (!('role' in data) || data.role == 'STANDARD_USER' || (data.role == 'ADMIN_OPERATOR' && isVerifiedRootAdmin()));
    }

    function isValidUserUpdate(newData, oldData, userId) {
      return newData.keys().hasOnly(['userId', 'email', 'displayName', 'username', 'role', 'createdAt', 'updatedAt']) &&
        newData.userId == oldData.userId &&
        newData.userId == userId &&
        newData.email is string && newData.email.size() > 0 && newData.email.size() <= 320 &&
        (!('displayName' in newData) || (newData.displayName is string && newData.displayName.size() <= 120)) &&
        (!('username' in newData) || (newData.username is string && newData.username.size() <= 120)) &&
        (!('createdAt' in oldData) || newData.createdAt == oldData.createdAt) &&
        (!('updatedAt' in newData) || isValidTimestampOrIso(newData.updatedAt)) &&
        (!('role' in newData) || newData.role == oldData.get('role', 'STANDARD_USER') || (newData.role == 'ADMIN_OPERATOR' && isVerifiedRootAdmin()));
    }

    function isValidThread(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'domain', 'createdAt', 'updatedAt']) &&
        (!('id' in data) || (data.id is string && data.id.size() > 0 && data.id.size() <= 128)) &&
        data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
        (!('domain' in data) || (data.domain is string && data.domain.size() <= 128)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidRecord(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'query', 'response', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'query', 'response', 'domain', 'confidenceScore', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId == userId &&
        data.query is string && data.query.size() > 0 && data.query.size() <= 20000 &&
        data.response is string && data.response.size() <= 100000 &&
        (!('domain' in data) || (data.domain is string && data.domain.size() <= 128)) &&
        (!('confidenceScore' in data) || (data.confidenceScore is number && data.confidenceScore >= 0.0 && data.confidenceScore <= 1.0)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidGoal(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'status', 'progress', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
        data.status is string && data.status.size() > 0 && data.status.size() <= 64 &&
        (!('progress' in data) || (data.progress is number && data.progress >= 0.0 && data.progress <= 100.0)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidOverrideHistory(data, userId) {
      return data.keys().hasAll(['id', 'timestamp', 'reason', 'adminUser']) &&
        ('auditCommitmentSeal' in data || 'zkSnarkSeal' in data) &&
        data.keys().hasOnly([
          'id', 'userId', 'timestamp', 'prevState', 'postState', 'reason',
          'zkSnarkSeal', 'auditCommitmentSeal', 'prevCommitmentHash', 'adminUser'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        (!('userId' in data) || data.userId == userId) &&
        data.timestamp is int && data.timestamp > 0 &&
        (!('prevState' in data) || data.prevState is map) &&
        (!('postState' in data) || data.postState is map) &&
        data.reason is string && data.reason.size() <= 2000 &&
        (!('zkSnarkSeal' in data) || (data.zkSnarkSeal is string && data.zkSnarkSeal.size() <= 256)) &&
        (!('auditCommitmentSeal' in data) || (data.auditCommitmentSeal is string && data.auditCommitmentSeal.size() <= 256)) &&
        (!('prevCommitmentHash' in data) || (data.prevCommitmentHash is string && data.prevCommitmentHash.size() <= 128)) &&
        data.adminUser is string && data.adminUser.size() <= 320;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['userId', 'actionType', 'commitmentHash', 'timestamp']) &&
        data.keys().hasOnly([
          'userId', 'actionType', 'commitmentHash', 'prevCommitmentHash', 'commitmentAlgorithm',
          'timestamp', 'overrideActive', 'triggerVector', 'exclusionProof', 'minimizationCheck',
          'details', 'proofOfNecessity', 'query', 'rSystemic', 'tier', 'nonce'
        ]) &&
        data.userId == request.auth.uid &&
        data.actionType is string && data.actionType.size() > 0 && data.actionType.size() <= 128 &&
        data.commitmentHash is string && data.commitmentHash.size() >= 16 && data.commitmentHash.size() <= 128 &&
        (!('prevCommitmentHash' in data) || (data.prevCommitmentHash is string && data.prevCommitmentHash.size() <= 128)) &&
        (!('commitmentAlgorithm' in data) || (data.commitmentAlgorithm is string && data.commitmentAlgorithm.size() <= 64)) &&
        data.timestamp is int && data.timestamp > 0 &&
        (!('overrideActive' in data) || data.overrideActive is bool);
    }

    function isValidOmnisSession(data) {
      return data.keys().hasAll(['userId', 'status', 'createdAt']) &&
        data.keys().hasOnly(['sessionId', 'userId', 'status', 'focusedDomain', 'createdAt', 'updatedAt']) &&
        (!('sessionId' in data) || (data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 128)) &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.status is string && data.status.size() > 0 && data.status.size() <= 64 &&
        (!('focusedDomain' in data) || (data.focusedDomain is string && data.focusedDomain.size() <= 128)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidProofOfNecessity(data) {
      return data.keys().hasAll(['userId', 'trigger_vector', 'exclusion_proof', 'minimization_check', 'timestamp']) &&
        data.keys().hasOnly(['userId', 'trigger_vector', 'exclusion_proof', 'minimization_check', 'timestamp', 'system_tension_sigma']) &&
        data.userId == request.auth.uid &&
        data.trigger_vector is string && data.trigger_vector.size() > 0 && data.trigger_vector.size() <= 4000 &&
        data.exclusion_proof is string && data.exclusion_proof.size() > 0 && data.exclusion_proof.size() <= 4000 &&
        data.minimization_check is string && data.minimization_check.size() > 0 && data.minimization_check.size() <= 4000 &&
        data.timestamp is int && data.timestamp > 0 &&
        (!('system_tension_sigma' in data) || (data.system_tension_sigma is number && data.system_tension_sigma >= 0.0 && data.system_tension_sigma <= 1.0));
    }

    function isValidAgentDeliberation(data) {
      return data.keys().hasAll(['userId', 'debateId', 'timestamp']) &&
        data.keys().hasOnly(['userId', 'debateId', 'timestamp', 'verdict', 'overrideActive']) &&
        data.debateId is string && data.debateId.size() > 0 && data.debateId.size() <= 128 &&
        data.timestamp is int && data.timestamp > 0 &&
        (!('verdict' in data) || (data.verdict is string && data.verdict.size() <= 10000)) &&
        (!('overrideActive' in data) || data.overrideActive is bool);
    }

    function isValidSystemDoc(data) {
      return data.keys().hasAll(['tokens', 'syncStatus', 'threats']) &&
        data.keys().hasOnly(['tokens', 'syncStatus', 'threats', 'updatedAt']) &&
        data.tokens is int && data.tokens >= 0 &&
        data.syncStatus is string && data.syncStatus.size() > 0 && data.syncStatus.size() <= 128 &&
        data.threats is int && data.threats >= 0 &&
        (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt));
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserCreate(incoming(), userId);
      allow update: if isValidId(userId) && (isAdmin() || (isOwner(userId) && isValidUserUpdate(incoming(), existing(), userId)));
      allow delete: if isValidId(userId) && isAdmin();

      match /threads/{threadId} {
        allow get: if isValidId(threadId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(threadId) && (isOwner(userId) || isAdmin()) && isValidThread(incoming(), userId);
        allow update: if isValidId(threadId) && (isOwner(userId) || isAdmin()) && isValidThread(incoming(), userId) && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(threadId) && (isOwner(userId) || isAdmin());
      }

      match /records/{recordId} {
        allow get: if isValidId(recordId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(recordId) && (isOwner(userId) || isAdmin()) && isValidRecord(incoming(), userId);
        allow update: if isValidId(recordId) && (isOwner(userId) || isAdmin()) && isValidRecord(incoming(), userId) && incoming().id == existing().id && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(recordId) && (isOwner(userId) || isAdmin());
      }

      match /goals/{goalId} {
        allow get: if isValidId(goalId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(goalId) && (isOwner(userId) || isAdmin()) && isValidGoal(incoming(), userId);
        allow update: if isValidId(goalId) && (isOwner(userId) || isAdmin()) && isValidGoal(incoming(), userId) && incoming().id == existing().id && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(goalId) && (isOwner(userId) || isAdmin());
      }

      match /override_history/{historyId} {
        allow get: if isValidId(historyId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(historyId) && (isOwner(userId) || isAdmin()) && isValidOverrideHistory(incoming(), userId);
        allow update, delete: if false;
      }
    }

    // ZK-Audit Ledger: Immutable append-only audit logs
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isValidId(logId) && isSignedIn() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // O.M.N.I.S. Sessions & Context
    match /omnis_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isValidId(sessionId) && isSignedIn() && isValidOmnisSession(incoming()) && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isValidId(sessionId) && isSignedIn() && isValidOmnisSession(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isValidId(sessionId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Proof of Necessity (PoN) Forensic Ledger: Immutable append-only
    match /proof_of_necessity/{ponId} {
      allow get: if isValidId(ponId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isValidId(ponId) && isSignedIn() && isValidProofOfNecessity(incoming());
      allow update, delete: if false;
    }

    // Multi-Agent Deliberations & Override Telemetry
    match /agent_deliberations/{deliberationId} {
      allow get: if isValidId(deliberationId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isValidId(deliberationId) && isSignedIn() && isValidAgentDeliberation(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isValidId(deliberationId) && isAdmin() && isValidAgentDeliberation(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;
    }

    // System metrics & parameters
    match /system/{docId} {
      allow get: if isValidId(docId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(docId) && isAdmin() && isValidSystemDoc(incoming());
      allow delete: if isValidId(docId) && isAdmin();
    }
  }
}
