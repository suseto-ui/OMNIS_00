# ==============================================================================
# O.M.N.I.S. APEX v4.5 - $0/Month Sovereign Open-Source Environment Template
# ==============================================================================

ENV=production
USE_OSS_POSTGRES_SYNC=true
REQUIRE_APP_CHECK=false
DOMAIN_NAME=omnisbysuseto.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token-here

# PostgreSQL 17 Multi-Engine Database
POSTGRES_DB=omnis_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-master-password
POSTGRES_APP_USER=omnis_app_rw
POSTGRES_APP_PASSWORD=replace-with-strong-app-rw-password
POSTGRES_AUDIT_USER=omnis_audit_append
POSTGRES_AUDIT_PASSWORD=replace-with-strong-audit-password
POSTGRES_SYNC_USER=omnis_sync_repl
POSTGRES_SYNC_PASSWORD=replace-with-strong-sync-repl-password

DATABASE_URL=postgresql+asyncpg://omnis_app_rw:replace-with-strong-app-rw-password@db:5432/omnis_db
AUDIT_DATABASE_URL=postgresql+asyncpg://omnis_audit_append:replace-with-strong-audit-password@db:5432/omnis_db

# ElectricSQL Sync Service
ELECTRIC_URL=http://electric:3000
ELECTRIC_INSECURE=false
ELECTRIC_SECRET=replace-with-secure-electric-secret-key

# Open-Weights & Free Multi-Provider LLM Cascade
# Modes: gemma4_local | groq | gemini | openrouter | all
LLM_PROVIDER_MODE=gemma4_local
GEMMA4_API_BASE_URL=http://host.docker.internal:11434/v1
GEMMA4_MODEL_NAME=gemma4:e4b
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Security & Cryptographic Audit Keys
SECRET_KEY=replace-with-random-64-char-jwt-signing-secret
AUDIT_HMAC_KEY=replace-with-random-64-char-audit-hmac-secret
OMNIS_SYNC_API_KEY=replace-with-random-64-char-sync-gateway-key
OMNIS_ADMIN_SECRET_HASHES=replace-with-sha256-hash-of-admin-passcode
