# ==============================================================================
# O.M.N.I.S. APEX v4.5 - Environment Template (Open-Source & Hybrid Fallback)
# Copy to .env for local Docker Compose; use GCP Secret Manager in production.
# ==============================================================================

# Environment & Feature Flags
ENV=development
USE_OSS_POSTGRES_SYNC=true
REQUIRE_APP_CHECK=false

# PostgreSQL 17 (pgvector + Apache AGE + pgcrypto + Logical Replication)
POSTGRES_DB=omnis_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
POSTGRES_APP_USER=omnis_app_rw
POSTGRES_APP_PASSWORD=YOUR_OMNIS_APP_RW_PASSWORD
POSTGRES_AUDIT_USER=omnis_audit_append
POSTGRES_AUDIT_PASSWORD=YOUR_OMNIS_AUDIT_APPEND_PASSWORD
POSTGRES_SYNC_USER=omnis_sync_repl
POSTGRES_SYNC_PASSWORD=YOUR_OMNIS_SYNC_REPL_PASSWORD

# Async SQLAlchemy DSN (local Docker Compose or Cloud SQL private IP)
DATABASE_URL=postgresql+asyncpg://omnis_app_rw:YOUR_OMNIS_APP_RW_PASSWORD@localhost:5432/omnis_db
AUDIT_DATABASE_URL=postgresql+asyncpg://omnis_audit_append:YOUR_OMNIS_AUDIT_APPEND_PASSWORD@localhost:5432/omnis_db

# ElectricSQL Sync Engine (Apache-2.0)
ELECTRIC_URL=http://localhost:3000
ELECTRIC_INSECURE=true

# Open-Weights LLM Inference Gateway (Gemma 4 via Ollama / vLLM / llama.cpp)
# Modes: gemma4_local | gemma4_cloud_fallback | gemini_legacy
LLM_PROVIDER_MODE=gemma4_local
GEMMA4_API_BASE_URL=http://localhost:11434/v1
GEMMA4_MODEL_NAME=gemma4:e4b
GEMMA4_API_KEY=

# Optional Legacy / Cloud Fallback Gemini Keys (AI Studio Secrets Panel)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY_2=YOUR_GEMINI_API_KEY_2
GEMINI_API_KEY_3=YOUR_GEMINI_API_KEY_3
GEMINI_MODEL=gemini-2.5-flash

# Security & Cryptographic Audit Secrets
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SECRET_KEY=YOUR_SECURE_RANDOM_JWT_SECRET_KEY
AUDIT_HMAC_KEY=YOUR_SECURE_RANDOM_AUDIT_HMAC_KEY
OMNIS_SYNC_API_KEY=YOUR_SECURE_RANDOM_SYNC_GATEWAY_KEY
OMNIS_ADMIN_SECRET_HASHES=sha256-hex-admin-secret-hash-1,sha256-hex-admin-secret-hash-2

# Optional Legacy Cloud / Firebase Configuration (Deprecated when USE_OSS_POSTGRES_SYNC=true)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
FIREBASE_PROJECT_ID=gen-lang-client-0328950802
FIRESTORE_DATABASE_ID=ai-studio-android-omnis-fba4ba28-3ec2-4eaf-a1a7-338554af8dfe
ENABLE_FIRESTORE_CQRS_PROJECTION=false

# GitHub Synchronization
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
GITHUB_REPO=https://github.com/suseto-ui/OMNIS_00.git
