# ==============================================================================
# O.M.N.I.S. APEX v4.5 - $0/Month Sovereign Open-Source Environment Template
# ==============================================================================

ENV=production
USE_OSS_POSTGRES_SYNC=true
DOMAIN_NAME=omnis.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token-here

# PostgreSQL 17 Multi-Engine Database
POSTGRES_DB=omnis_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SecurePostgresMasterPassword123!
POSTGRES_APP_USER=omnis_app_rw
POSTGRES_APP_PASSWORD=SecureAppRwPassword123!
POSTGRES_AUDIT_USER=omnis_audit_append
POSTGRES_AUDIT_PASSWORD=SecureAuditPassword123!
POSTGRES_SYNC_USER=omnis_sync_repl
POSTGRES_SYNC_PASSWORD=SecureSyncReplPassword123!

DATABASE_URL=postgresql+asyncpg://omnis_app_rw:SecureAppRwPassword123!@db:5432/omnis_db
AUDIT_DATABASE_URL=postgresql+asyncpg://omnis_audit_append:SecureAuditPassword123!@db:5432/omnis_db

# ElectricSQL Sync Service
ELECTRIC_URL=http://electric:3000
ELECTRIC_INSECURE=true

# Open-Weights & Free Multi-Provider LLM Cascade
# Modes: gemma4_local | groq | gemini | openrouter
LLM_PROVIDER_MODE=gemma4_local
GEMMA4_API_BASE_URL=http://host.docker.internal:11434/v1
GEMMA4_MODEL_NAME=gemma4:e4b
GROQ_API_KEY=gsk_your_free_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_free_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1_your_free_openrouter_key_here

# Security & Cryptographic Audit Keys
SECRET_KEY=super-secret-jwt-key-32-chars-minimum-security
AUDIT_HMAC_KEY=super-secret-hmac-key-32-chars-minimum-security
OMNIS_SYNC_API_KEY=omnis-sync-gateway-shared-secret-key
OMNIS_ADMIN_SECRET_HASHES=a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3
